# Browser-visible MapTiler key. Restrict it to your Vercel domains in MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=
# Server-side routing key. Never expose this as NEXT_PUBLIC_*.
OPENROUTESERVICE_API_KEY=

# Added automatically if the Supabase/Vercel integration is installed.
# The code also accepts the legacy NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY names.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
